<div class="recently-viewed-section" id="RecentlyViewed-{{ block.id }}"
  data-current-product="{{ product.handle }}"
  {{ block.shopify_attributes }}
  style="display: none;">
  <h3 class="recently-viewed-heading" style="color: {{ block.settings.heading_color }};">
    {{ block.settings.heading }}
  </h3>
  <div class="recently-viewed-grid" id="RecentlyViewedGrid-{{ block.id }}"></div>
</div>

<style>
  .recently-viewed-section {
    margin: 32px 0;
    padding-top: 24px;
    border-top: 1px solid #E5E5E5;
  }
  .recently-viewed-heading {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px;
  }
  .recently-viewed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
  .rv-item {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .rv-item img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 8px;
  }
  .rv-item-title {
    font-size: 13px;
    font-weight: 500;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .rv-item-price {
    font-size: 13px;
    color: #666;
    margin: 0;
  }
</style>

<script>
  (function() {
    const STORAGE_KEY = 'shopify_recently_viewed';
    const MAX_ITEMS = 8;
    const currentHandle = "{{ product.handle }}";

    if (!currentHandle) return;

    // Step 1: Save current product to history
    let viewed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    viewed = viewed.filter(h => h !== currentHandle);
    viewed.unshift(currentHandle);
    viewed = viewed.slice(0, MAX_ITEMS);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(viewed));

    // Step 2: Render list excluding current product
    const toShow = viewed.filter(h => h !== currentHandle).slice(0, {{ block.settings.count }});
    if (toShow.length === 0) return;

    const section = document.getElementById('RecentlyViewed-{{ block.id }}');
    const grid = document.getElementById('RecentlyViewedGrid-{{ block.id }}');

    Promise.all(
      toShow.map(handle =>
        fetch(`/products/${handle}.js`).then(res => res.ok ? res.json() : null).catch(() => null)
      )
    ).then(products => {
      products = products.filter(p => p !== null);
      if (products.length === 0) return;

      grid.innerHTML = products.map(p => `
        <a href="/products/${p.handle}" class="rv-item">
          <img src="${p.featured_image || p.images[0] || ''}" alt="${p.title}" loading="lazy">
          <p class="rv-item-title">${p.title}</p>
          <p class="rv-item-price">${(p.price / 100).toLocaleString('en-IN', { style: 'currency', currency: '{{ cart.currency.iso_code | default: "INR" }}' })}</p>
        </a>
      `).join('');

      section.style.display = 'block';
    });
  })();
</script>

{% schema %}
{
  "name": "Recently Viewed Products",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Number of products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}